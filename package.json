{
  "name": "iclaw",
  "version": "0.1.0",
  "private": true,
  "description": "WeChat <-> Pi Agent standalone bridge with web admin",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "web:dev": "vite --config vite.config.ts",
    "web:build": "vite build --config vite.config.ts",
    "login": "tsx src/cli.ts login",
    "run": "tsx src/cli.ts run",
    "echo": "tsx src/cli.ts echo",
    "serve": "tsx src/server/index.ts",
    "status": "tsx src/cli.ts status"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-session-backend-sqlite-node": "^0.84.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.11.3",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
