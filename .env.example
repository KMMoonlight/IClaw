# --- IClaw 配置（复制为 .env 后修改）---

# 模型（自定义 OpenAI / Anthropic 兼容端点）
# ICLAW_MODEL_PROVIDER：provider 名，见 README 的「支持的 provider」表
ICLAW_MODEL_PROVIDER=deepseek
ICLAW_MODEL=deepseek-chat
# ICLAW_MODEL_BASE_URL 可选：不设则用 provider 的内置默认地址
# ICLAW_MODEL_BASE_URL=https://api.deepseek.com
ICLAW_API_KEY=sk-...

# 模型能力（可选，默认值如下）
# ICLAW_MODEL_CONTEXT_WINDOW=128000
# ICLAW_MODEL_MAX_TOKENS=8192
# 模型是否支持图片输入；纯文本模型设为 false，收到的图片会转为文字提示
# ICLAW_MODEL_SUPPORTS_IMAGES=true

# 每轮对话后自动抽取值得长期记住的事实（会额外调用一次模型，默认关闭）
# ICLAW_MEMORY_AUTO_EXTRACT=false

# 可选：embedding 模型（OpenAI 兼容 /embeddings），用于记忆的语义检索
# 不配置、或调用失败时，记忆检索自动降级为关键词匹配
# ICLAW_EMBEDDING_MODEL=text-embedding-3-small
# ICLAW_EMBEDDING_BASE_URL=  # 缺省复用 ICLAW_MODEL_BASE_URL / provider 内置地址

# 定时任务调度器（提醒 / 周期任务 / 网页监控）
# ICLAW_SCHEDULER_ENABLED=true
# ICLAW_SCHEDULER_INTERVAL_MS=30000

# 执行类工具（bash / 文件读写）：默认关闭；开启后限定在 per-user workspace
# ICLAW_TOOLS_EXEC=false
# ICLAW_WORKSPACE_DIR=./data/workspaces
# ICLAW_EXEC_TIMEOUT_MS=30000
# ICLAW_EXEC_MAX_OUTPUT_BYTES=100000
# 沙箱：auto（有 bwrap/sandbox-exec 就用）/ required（无沙箱则拒绝执行）/ none
# ICLAW_EXEC_SANDBOX=auto
# ICLAW_EXEC_ALLOW_NETWORK=false
# 人工审批（可选，默认关闭）：留空 = 所有工具直接执行（默认放行）
# 如需对个别危险工具加人工确认，填工具名（逗号分隔），例如：
# ICLAW_APPROVAL_TOOLS=bash,write_file

# 联网搜索 web_search：none / tavily / brave / searxng
# ICLAW_SEARCH_PROVIDER=none
# ICLAW_SEARCH_API_KEY=
# ICLAW_SEARCH_BASE_URL=

# 主模型失败时自动重试的备用模型（可选）
# ICLAW_MODEL_FALLBACK=
# 按用户配额（0 = 不限）
# ICLAW_USER_DAILY_TOKEN_LIMIT=0
# ICLAW_USER_RATE_PER_MIN=0
# 出站发送失败重试次数
# ICLAW_SEND_RETRIES=2

# 出站内容黑名单（正则，逗号分隔）与替代文本
# ICLAW_OUTBOUND_BLOCKLIST=
# ICLAW_OUTBOUND_BLOCK_MESSAGE=抱歉，这条内容不适合发送。
# 数据保留天数（0 = 永久保留）
# ICLAW_DATA_RETENTION_DAYS=0

# 消息输出
# ICLAW_SEND_CHUNK_CHARS=2000   # 单条消息最大字符数，超过自动分片
# ICLAW_STREAM_PROGRESS=true    # 生成过程中分段推送长回复
# ICLAW_SEND_MEDIA_MAX_BYTES=20971520  # send_file/send_image 文件大小上限（20MB）

ICLAW_SYSTEM_PROMPT=你是一个乐于助人的助手。用用户使用的语言简洁地回答。

# 日志级别：debug / info / warn / error（默认 info）
# ICLAW_LOG_LEVEL=info

# 路径
ICLAW_STATE_DIR=./data
ICLAW_SKILLS_DIR=./skills
ICLAW_MCP_CONFIG=./mcp.json

# Web 管理端
ICLAW_SERVER_HOST=127.0.0.1
ICLAW_SERVER_PORT=3000
ICLAW_ADMIN_USER=admin
# 管理员密码（权威）：每次启动都会将库中密码同步为该值；不设则首次自动生成并打印到日志
# ICLAW_ADMIN_PASSWORD=
# 对外暴露管理端时：配 HTTPS 后设为 true，让会话 cookie 带 Secure 标志
# ICLAW_COOKIE_SECURE=false
